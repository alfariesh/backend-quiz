DATABASE_URL=postgres://flashcard:flashcard@localhost:5432/flashcard?sslmode=disable

# ── Voyage AI: embeddings + reranker ───────────────────────────────
# Get a key at https://dash.voyageai.com (200M tokens free tier).
VOYAGE_API_KEY=pa-xxx
# voyage-context-3: contextualized chunk embeddings (native doc-context awareness).
VOYAGE_EMBED_MODEL=voyage-context-3
# 1024 = Matryoshka truncation from 2048. Halves storage vs 2048 with minimal
# quality loss. Must match vector(N) in migration 00024.
VOYAGE_EMBED_DIM=1024
# rerank-2.5: 32k context multilingual cross-encoder.
VOYAGE_RERANK_MODEL=rerank-2.5
# Override only if Voyage publishes a new base URL or you run a proxy.
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# ── LLM (OpenAI-compatible: SumoPod / OpenRouter / OpenAI) ─────────
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_MODEL=MiniMax-M2.7-highspeed
# Small/cheap model for background conversation-title generation.
LLM_TITLE_MODEL=gemini/gemini-3.1-flash-lite-preview
# (optional) Override LLM used by eval LLM-as-judge. Default inside eval/run_eval.py.
# EVAL_JUDGE_MODEL=glm-5-turbo

# ── Retrieval tuning ───────────────────────────────────────────────
DENSE_CANDIDATES=40        # per-leg candidates before RRF
LEXICAL_CANDIDATES=40
RRF_K=60                   # RRF smoothing constant (60 is the canonical value)
RERANK_TOPK=8              # final top-k after Voyage rerank-2.5
RERANK_ENABLED=true        # set false to skip rerank for latency/cost tests

CONVERSATION_HISTORY_TURNS=6

HOST=127.0.0.1
PORT=8001

# Shared token with Go backend — required when rag-service is reachable from
# anywhere other than localhost. If empty, auth check is disabled (dev only).
INTERNAL_AUTH_TOKEN=
