DATABASE_URL=postgres://flashcard:flashcard@localhost:5432/flashcard?sslmode=disable

# Embeddings — SumoPod (OpenAI-compatible)
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://ai.sumopod.com/v1
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536

# LLM — OpenRouter
LLM_API_KEY=sk-or-v1-xxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=x-ai/grok-4.1-fast
# Small/cheap model used only for background conversation-title generation.
LLM_TITLE_MODEL=mistralai/mistral-nemo

# Reranker — Jina (optional; general mode works without it)
JINA_API_KEY=
JINA_MODEL=jina-reranker-v2-base-multilingual

# Retrieval tuning
TREE_REASONING_MAX_NODES=10
TREE_PROGRESSIVE_THRESHOLD=60
VECTOR_TOPK=5
SKIP_VECTOR_CHUNK_THRESHOLD=10
GENERAL_CANDIDATES=20
GENERAL_TOPK=5
TREE_CACHE_TTL_SECONDS=300
CONVERSATION_HISTORY_TURNS=6

HOST=127.0.0.1
PORT=8001

# Shared token with Go backend — required when rag-service is reachable from
# anywhere other than localhost. If empty, auth check is disabled (dev only).
INTERNAL_AUTH_TOKEN=
