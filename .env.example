# Server
SERVER_PORT=8080
ENVIRONMENT=development
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

# Database
DATABASE_URL=postgres://flashcard:flashcard@localhost:5432/flashcard?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=720h

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
GOOGLE_FAILURE_REDIRECT=http://localhost:3000/auth/error

APP_FRONTEND_URL=http://localhost:3000

# Mailer (Resend)
RESEND_API_KEY=
MAIL_FROM=Surau Quiz <noreply@example.com>
MAIL_REPLY_TO=

# App / Frontend
APP_NAME=Surau Quiz

# Auth policy
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL=15m
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_RESET_TOKEN_TTL=15m
AUTH_LOGIN_LOCKOUT_WINDOW=15m
AUTH_LOGIN_LOCKOUT_MAX_FAILS=5
AUTH_REQUIRE_EMAIL_VERIFIED=false
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=72
AUTH_PASSWORD_REQUIRE_MIXED=false
# Check new passwords against HaveIBeenPwned (fail-open if API unreachable).
AUTH_PASSWORD_HIBP_CHECK=true
# Grace period before a deletion-requested account is hard-deleted (e.g. 720h = 30d).
AUTH_DELETION_GRACE_PERIOD=720h

# Security (CORS, proxy, HSTS, auth-endpoint rate limit)
# Comma-separated origins. Use "*" for any (dev only; disables credentials).
SECURITY_ALLOWED_ORIGINS=http://localhost:3000
# Set true ONLY when behind a trusted reverse proxy (nginx, cloudflare, etc).
SECURITY_TRUST_FORWARDED_FOR=false
# HSTS max-age seconds — 0 disables (dev). Production: 31536000 (1 year).
SECURITY_HSTS_MAX_AGE=0
# Optional Content-Security-Policy. Only set if serving HTML from this origin.
SECURITY_CSP=
# Per-IP rate limit for /auth/* endpoints (stricter than global).
SECURITY_AUTH_RL_RPS=0.5
SECURITY_AUTH_RL_BURST=5

# CAPTCHA (Cloudflare Turnstile). Empty = disabled.
TURNSTILE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=flashcard-media
R2_PUBLIC_URL=https://your-bucket.r2.dev
R2_MAX_FILE_SIZE_MB=10

# FSRS
FSRS_DEFAULT_RETENTION=0.9
FSRS_MAX_INTERVAL=36500
FSRS_ENABLE_FUZZ=true

# RAG proxy → Python rag-service
RAG_SERVICE_URL=http://localhost:8001
RAG_TIMEOUT=120s
RAG_STREAM_TIMEOUT=3m
# Shared secret between Go api and rag-service. MUST be set in production.
# docker-compose maps this same value into rag-service as INTERNAL_AUTH_TOKEN.
RAG_INTERNAL_TOKEN=
RAG_USER_RPS=0.5
RAG_USER_BURST=3
RAG_DAILY_LIMIT=100
