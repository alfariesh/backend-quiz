# Server
SERVER_PORT=8080
ENVIRONMENT=development
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

# Database
DATABASE_URL=postgres://flashcard:flashcard@localhost:5432/flashcard?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=720h

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=flashcard-media
R2_PUBLIC_URL=https://your-bucket.r2.dev
R2_MAX_FILE_SIZE_MB=10

# FSRS
FSRS_DEFAULT_RETENTION=0.9
FSRS_MAX_INTERVAL=36500
FSRS_ENABLE_FUZZ=true
