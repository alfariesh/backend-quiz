DATABASE_URL=postgres://flashcard:flashcard@localhost:5432/flashcard?sslmode=disable

PDF_DIR=/path/to/Surau Kitab

# ── Voyage AI (shared with rag-service) ────────────────────────────
# Get a key at https://dash.voyageai.com
VOYAGE_API_KEY=pa-xxx
VOYAGE_EMBED_MODEL=voyage-context-3
VOYAGE_EMBED_DIM=1024
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# ── Chunking ───────────────────────────────────────────────────────
CHUNK_TARGET_CHARS=1200      # ~300-400 tokens for Arabic
EMBED_BATCH=25               # chunks per contextualized request (fits 32K context window)
